BACKUP ~Barbarian Kit/Backup~
AUTHOR ~Greener~
VERSION ~1.0~

AUTO_EVAL_STRINGS

LANGUAGE
  ~English~
  ~english~
  ~Barbarian Kit/Language/English/game.tra~
  ~Barbarian Kit/Language/English/weidu.tra~

BEGIN @1
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee iwdee~ @2
ACTION_IF FILE_EXISTS_IN_GAME ~enginest.2da~ BEGIN

COPY_EXISTING ~ABCLASRQ.2DA~ override
  SET_2DA_ENTRY  49 1 7 ~12~ // Barbarian strength requirement (12) 
  SET_2DA_ENTRY  49 2 7 ~9~  // Barbarian dexterity requirement (9) 
  SET_2DA_ENTRY  49 3 7 ~12~ // Barbarian wisdom requirement (12)

COPY_EXISTING ~ALIGNMNT.2DA~ override
  SET_2DA_ENTRY  49 1 10 ~0~ // Alignment restricted to any non-lawful 
  SET_2DA_ENTRY  49 2 10 ~0~ // Alignment restricted to any non-lawful 
  SET_2DA_ENTRY  49 3 10 ~0~ // Alignment restricted to any non-lawful

COPY_EXISTING ~CLSRCREQ.2DA~ override
  SET_2DA_ENTRY  16 2 7 ~0~ // Race restricted to human
  SET_2DA_ENTRY  16 3 7 ~0~ // Race restricted to human
  SET_2DA_ENTRY  16 4 7 ~0~ // Race restricted to human
  SET_2DA_ENTRY  16 5 7 ~0~ // Race restricted to human
  SET_2DA_ENTRY  16 6 7 ~0~ // Race restricted to human
  SET_2DA_ENTRY  16 7 7 ~0~ // Race restricted to human

COPY_EXISTING ~HPBARB.2DA~ override
  SET_2DA_ENTRY  10 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  11 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  12 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  13 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  14 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  15 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  16 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  17 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  18 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  19 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  20 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  21 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  22 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  23 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  24 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  25 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  26 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  27 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  28 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  29 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  30 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  31 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  32 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  33 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  34 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  35 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  36 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  37 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  38 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  39 3 3 ~4~ // Level based hit point adjustment +4
  SET_2DA_ENTRY  40 3 3 ~4~ // Level based hit point adjustment +4

COPY_EXISTING ~WEAPPROF.2DA~ override //May not exceed specialization (two slots) in two-weapon fighting style
  SET_2DA_ENTRY  33 52 2 2

COPY ~Barbarian Kit/CLAB/CLABFI05.2DA~ ~override~

COPY ~Barbarian Kit/Spells/SPCL151.SPL~ ~override~       						
  SAY UNIDENTIFIED_DESC @4

COPY ~Barbarian Kit/Spells/SPCL152.SPL~ ~override~    				
  SAY UNIDENTIFIED_DESC @5

COPY ~Barbarian Kit/Spells/SPCL153.SPL~ ~override~        						
  SAY UNIDENTIFIED_DESC @6

COPY ~Barbarian Kit/Spells/SPCL154.SPL~ ~override~         						
  SAY UNIDENTIFIED_DESC @7

COPY ~Barbarian Kit/Spells/SPCL155.SPL~ ~override~         						
  SAY UNIDENTIFIED_DESC @8

ACTION_IF GAME_IS ~bgee bg2ee iwdee~ BEGIN // Restrict barbarians to only wearing leather, studded leather, and/or hide armor
	COPY_EXISTING_REGEXP "^.+\.itm" override
    READ_SHORT 0x22 anim
    READ_LONG 0x18 flags
      PATCH_IF (anim = 16691) BEGIN
        WRITE_BYTE 0x29 (THIS BOR BIT6)
      END
	BUT_ONLY
END

ACTION_IF GAME_IS ~bgee~ THEN BEGIN
  STRING_SET ~24235~ @9 
  STRING_SET ~25390~ @9
END

ACTION_IF GAME_IS ~bg2ee iwdee~ THEN BEGIN
  STRING_SET ~45869~ @9
  STRING_SET ~102497~ @10
END
END

BEGIN @3
REQUIRE_PREDICATE GAME_IS ~bg2ee~ @2
ACTION_IF FILE_EXISTS_IN_GAME ~enginest.2da~ BEGIN
INCLUDE ~Barbarian Kit/library/hla_actions.tpa~
COPY_EXISTING ~Barbarian Kit/Spells/SPCL950.SPL~ ~override~			
  SAY NAME1 @11
  SAY UNIDENTIFIED_DESC @12
    LAF action_add_hla STR_VAR kit_name = ~BARBARIAN~ ability = ~GA_SPCL950~ min_lev = ~1~ num_allowed = ~1~ END
END